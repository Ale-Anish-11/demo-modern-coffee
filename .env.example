# Django Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (SQLite by default, easily swapped with PostgreSQL)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# Khalti Gateway Configuration (KPG-2 ePayment)
# Sandbox Base URL: https://dev.khalti.com/api/v2/
# Production Base URL: https://khalti.com/api/v2/
KHALTI_BASE_URL=https://dev.khalti.com/api/v2/
KHALTI_PUBLIC_KEY=your_khalti_public_key_here
KHALTI_SECRET_KEY=your_khalti_secret_key_here

# Loyalty Program Settings
LOYALTY_POINTS_PER_HUNDRED=10
LOYALTY_POINT_REDEEM_VALUE=1.0
